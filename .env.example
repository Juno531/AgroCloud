# AgroCloud Environment Variables Template

# ----------------------------------------------------
# [ Frontend ]
# ----------------------------------------------------
# API Server Backend URL (e.g., http://localhost:8080)
# VITE_API_BASE_URL=

# ----------------------------------------------------
# [ Backend & Database - Docker ]
# ----------------------------------------------------
# Database Credentials
POSTGRES_DB=agrocloud
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# PgAdmin Credentials (Optional)
PGADMIN_DEFAULT_EMAIL=admin@agrocloud.com
PGADMIN_DEFAULT_PASSWORD=

# ----------------------------------------------------
# [ Backend - API / Security ]
# ----------------------------------------------------
# Security / Auth keys (Must be a 256-bit or greater secure string in production)
JWT_SECRET=

# Invitation codes
ADMIN_INVITE_CODE=
FARM_INVITE_CODE=

# Initial Super Admin Credentials
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# CORS
# Comma-separated list for allowed origins:
# e.g.: CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
CORS_ALLOWED_ORIGINS=

